# 4. HELPER BUILDER FUNCTIONS
def render_price_box(label: str, amount: str) -> str:
    return f"""
    <div class="price-box">
        <span class="price-label">{label}</span>
        <span class="price-amount"><span class="currency-sym">Rs.</span>{amount}</span>
    </div>
    """


def render_pizza_card(pizza: dict) -> str:
    prices_html = "".join(
        [render_price_box(size, price) for size, price in pizza["prices"].items()]
    )
    badge_html = (
        f'<span class="card-badge gold">{pizza["badge"]}</span>'
        if "badge" in pizza
        else ""
    )
    return f"""
    <div class="food-card">
        <div class="card-img-wrapper">
            {badge_html}
            <img src="{pizza['image']}" alt="{pizza['name']}" loading="lazy">
        </div>
        <div class="card-body">
            <h3 class="card-title">{pizza['name']}</h3>
            <p class="card-desc">{pizza['desc']}</p>
            <div class="prices-container">
                {prices_html}
            </div>
        </div>
    </div>
    """


def render_general_card(item: dict, is_gold_badge: bool = False) -> str:
    badge_class = "gold" if is_gold_badge else ""
    badge_html = (
        f'<span class="card-badge {badge_class}">{item["badge"]}</span>'
        if "badge" in item
        else ""
    )
    serving_html = (
        f'<div class="card-serving">{item["serving"]}</div>'
        if "serving" in item
        else ""
    )
    return f"""
    <div class="food-card">
        <div class="card-img-wrapper">
            {badge_html}
            <img src="{item['image']}" alt="{item['name']}" loading="lazy">
        </div>
        <div class="card-body">
            {serving_html}
            <h3 class="card-title">{item['name']}</h3>
            <p class="card-desc">{item['desc']}</p>
            <div class="prices-container">
                {render_price_box("Price", item['price'])}
            </div>
        </div>
    </div>
    """


